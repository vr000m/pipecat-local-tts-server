<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime, no App Sandbox: the app launches uv and the per-service
	     Python interpreters it installs, which run as separate processes. -->
	<!-- Microphone capture for the speech-to-text "Try it" (hardened runtime). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
